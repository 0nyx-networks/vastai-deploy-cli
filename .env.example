# Vast.ai API key. Instances read + write
VAST_API_KEY=

# Tailscale API access token (PAT). Either this or OAuth client must be set.
# Personal access token with devices:write + auth_keys
TAILSCALE_API_KEY=

# Tailnet name. "-" means "default tailnet for the authenticated user".
TAILSCALE_TAILNET=-

# Optional: SSH public key injected into the container (for Vast.ai SSH).
SSH_PUBLIC_KEY=
